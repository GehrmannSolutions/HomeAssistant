HA_URL=http://127.0.0.1:8123
HA_TOKEN=YOUR_HOME_ASSISTANT_LONG_LIVED_ACCESS_TOKEN
HA_ALLOW_WRITE=false
HA_ALLOW_ADMIN_WRITE=false
HA_ALLOW_DELETE=false
# Run a level's chat actions without approval card (needs the matching HA_ALLOW_* and the chat checkbox)
HA_AUTO_WRITE=false
HA_AUTO_ADMIN_WRITE=false
HA_AUTO_DELETE=false
HA_ALLOWED_DOMAINS=light,switch,fan,climate,cover,media_player

# Optional (defaults shown); the web UI sets these for its MCP child process itself.
# HA_CREDENTIALS_DIR=~/.config/ha-safe-mcp/credentials
# HA_AUDIT=true
# HA_AUDIT_DIR=~/.local/state/ha-safe-mcp/audit
